  "adaptations": {
    "import/no-cycle": "Remove unsupported disableScc option; import-x has its own cycle implementation.",
    "object-property-newline": "Remove obsolete allowMultiplePropertiesPerLine; allowAllPropertiesOnSameLine remains true.",
    "dot-notation": "Remove TypeScript-only false options from the core rule.",
    "@typescript-eslint/ban-types": "Removed rule split into no-empty-object-type, no-unsafe-function-type and no-wrapper-object-types; coverage differs.",
    "@typescript-eslint/no-throw-literal": "Rename to only-throw-error, preserving legacy any/unknown allowances."
  },
  "pins": {
    "no-unused-vars": {
      "caughtErrors": "none"
    },
    "@typescript-eslint/no-unused-vars": {
      "caughtErrors": "none"
    },
    "no-constant-condition": {
      "checkLoops": true
    },
    "no-inner-declarations": [
      "functions",
      {
        "blockScopedFunctions": "disallow"
      }
    ],
    "no-shadow-restricted-names": {
      "reportGlobalThis": false
    },
    "no-useless-computed-key": {
      "enforceForClassMembers": false
    },
    "class-methods-use-this": {
      "enforceForClassFields": false
    },
    "@stylistic/lines-between-class-members": [
      "always",
      {
        "exceptAfterSingleLine": false,
        "exceptAfterOverload": false
      }
    ],
    "@stylistic-ts/lines-between-class-members": [
      "always",
      {
        "exceptAfterSingleLine": false,
        "exceptAfterOverload": true
      }
    ],
    "@stylistic/no-multi-spaces": {
      "includeTabs": false,
      "exceptions": {
        "Property": true
      }
    }
  },
  "removed": [
    "react/jsx-sort-prop-types",
    "require-jsdoc",
    "valid-jsdoc"
  ]
}
